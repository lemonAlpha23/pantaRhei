{
  "name": "pantarhei-workspace",
  "version": "0.2.10",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "pnpm --filter @pantarhei/desktop dev",
    "dev:web": "pnpm --filter @pantarhei/desktop dev:web",
    "build": "pnpm --filter @pantarhei/desktop build",
    "test": "pnpm --filter @pantarhei/desktop test && uv run --directory apps/backend --locked pytest",
    "package": "pnpm --filter @pantarhei/desktop package"
  }
}
